# Application
APP_ENV=development
APP_NAME=Agentra
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentra_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentra_test_db

# Security & Tokens
JWT_SECRET_KEY=agentra_super_secure_secret_key_change_in_production_min_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File Storage
STORAGE_DIRECTORY=storage/documents
MAX_UPLOAD_SIZE_BYTES=26214400

# CORS (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
